# Copie este archivo como .env y ajuste los valores si es necesario.
# El backend lee las variables del entorno; no requiere el archivo para funcionar.

# Interfaz y puerto del servidor
NETFLIX_API_HOST=127.0.0.1
NETFLIX_API_PORT=8000

# Recarga automatica al editar el codigo (1 = activada, 0 = desactivada)
NETFLIX_API_RELOAD=1

# Origenes permitidos por CORS separados por coma (* para desarrollo local)
NETFLIX_CORS_ORIGINS=*
